{
  "name": "@firetell/firetell-node-sdk",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Official Node.js and TypeScript SDK for the Firetell Workspace API — programmable voice calls, SMS/MMS messaging, Voice AI agents, knowledge bases, and webhooks.",
  "keywords": [
    "firetell",
    "sdk",
    "voip",
    "voice",
    "telephony",
    "sms",
    "mms",
    "voice-ai",
    "call-center",
    "sip",
    "webhooks",
    "typescript",
    "nodejs"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "release": "npm run typecheck && npm run test && npm run build && npm publish --access=public --registry=https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firetellcom/firetell-node-sdk.git"
  },
  "author": "Firetell <developers@firetell.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/firetellcom/firetell-node-sdk/issues"
  },
  "homepage": "https://github.com/firetellcom/firetell-node-sdk#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
